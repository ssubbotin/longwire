# WebSocket URL of the local Grok agent serve endpoint.
# The agent listens on /ws — longwire appends /ws if missing.
GROK_AGENT_WS_URL=ws://127.0.0.1:2419

# Shared secret for serve auth (required).
# Must match: grok agent --always-approve serve --bind 127.0.0.1:2419 --secret <token>
# Or export GROK_AGENT_SECRET when starting the agent.
# Sent as Authorization: Bearer <token> (preferred) and also as ?server-key=<token>.
GROK_AGENT_SECRET=replace-me-with-a-long-random-token

# Default working directory for new ACP sessions.
GROK_AGENT_CWD=.
